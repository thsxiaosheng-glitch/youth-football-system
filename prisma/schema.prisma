generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  position  String
  speed     Int
  shooting  Int
  createdAt DateTime @default(now())
}
model Training {

  id        Int      @id @default(autoincrement())

  date      String

  title     String

  duration  Int

  intensity String

  note      String

  createdAt DateTime @default(now())

}